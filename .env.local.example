# ==========================================================================
#  Buka Delivery — .env.local.example
#
#  Αντίγραψέ το σε .env.local και συμπλήρωσε τις τιμές από:
#  Firebase Console → Project settings → General → Your apps → Web app → Config
#
#  ΤΟ .env.local ΔΕΝ ΜΠΑΙΝΕΙ ΣΤΟ GIT (το create-next-app το έχει ήδη στο
#  .gitignore). Αυτό εδώ το αρχείο-υπόδειγμα μπαίνει κανονικά.
#
#  Οι NEXT_PUBLIC_* τιμές ενσωματώνονται στο client bundle και είναι ορατές
#  σε όλους. Αυτό είναι αναμενόμενο στο Firebase: δεν είναι μυστικά, είναι
#  αναγνωριστικά. Την ασφάλεια την κάνουν τα Security Rules.
# ==========================================================================

NEXT_PUBLIC_FIREBASE_API_KEY=AIza...
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=buka-delivery.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=buka-delivery
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=buka-delivery.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abc123def456

# Βάλε 1 για να τρέξεις με τοπικούς emulators αντί για την παραγωγή:
#   firebase emulators:start --only firestore,auth
NEXT_PUBLIC_USE_FIREBASE_EMULATOR=0

# ----------------------------------------------------------------------
#  Μόνο για το scripts/seed.ts (Node, ποτέ στον browser).
#  Εναλλακτικά άφησέ το κενό και βάλε το serviceAccountKey.json στη ρίζα.
# ----------------------------------------------------------------------
# FIREBASE_SERVICE_ACCOUNT_PATH=serviceAccountKey.json
